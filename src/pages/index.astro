---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReefPane from '../components/ReefPane.astro';
import Experience from '../components/Experience.astro';
import profile from '../data/profile.json';
import experience from '../data/experience.json';
import githubMetaFile from '../data/github-meta.json';
import { STAGES, getCoralSpritePath, getStageMeta } from '../lib/reef';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const projectEntries = await getCollection('projects');
const noteEntries = await getCollection('notes');

const stageOrder: Record<string, number> = { reef: 0, branch: 1, bud: 2, polyp: 3 };

const repoCache = (githubMetaFile.repos || {}) as Record<
  string,
  { primaryLang: string; lastPush: string; commits: string; stars: string; htmlUrl?: string }
>;

const projects = projectEntries
  .map((entry) => {
    const slug = entry.id.replace(/\.md$/, '');
    const data = entry.data;
    const stageMeta = getStageMeta(data.stage);
    const spriteSrc = getCoralSpritePath(data.stage, data.species, data.spriteVariant, baseUrl);
    const ghMeta = data.githubRepo ? repoCache[data.githubRepo] ?? null : null;
    const paragraphs = (entry.body ?? '')
      .split(/\r?\n\r?\n/)
      .map((p) => p.trim())
      .filter(Boolean);
    return {
      slug,
      title: data.title,
      stage: data.stage,
      stageLabel: stageMeta.label,
      stageDesc: stageMeta.desc,
      stageTagClass: stageMeta.tagClass,
      species: data.species,
      spriteVariant: data.spriteVariant,
      spriteSrc,
      posX: data.posX,
      posY: data.posY,
      plantedDate: data.plantedDate,
      summary: data.summary,
      paragraphs,
      takeaways: data.takeaways ?? [],
      tools: data.tools ?? [],
      githubRepo: data.githubRepo ?? null,
      demoUrl: data.demoUrl ?? null,
      githubMeta: ghMeta,
      screenshotImage: data.screenshotImage ?? null,
      screenshotCaption: data.screenshotCaption ?? '',
      relatedNote: data.relatedNote ?? null,
    };
  })
  .sort((a, b) => stageOrder[a.stage] - stageOrder[b.stage]);

const notes = noteEntries.map((entry) => {
  const slug = entry.id.replace(/\.md$/, '');
  const paragraphs = (entry.body ?? '')
    .split(/\r?\n\r?\n/)
    .map((p) => p.trim())
    .filter(Boolean);
  return {
    slug,
    title: entry.data.title,
    date: entry.data.date,
    tag: entry.data.tag,
    projectSlug: entry.data.projectSlug ?? null,
    paragraphs,
  };
});

const syncedAt = githubMetaFile.syncedAt || '26 November 2026';

const clientPayload = {
  stages: STAGES,
  projects,
  notes,
  email: profile.email,
  baseUrl,
};
---

<BaseLayout title={profile.name}>
  <div class="jm-split">
    <ReefPane
      projects={projects.map((p) => ({
        slug: p.slug,
        title: p.title,
        stage: p.stage,
        species: p.species,
        spriteVariant: p.spriteVariant,
        posX: p.posX,
        posY: p.posY,
      }))}
      baseUrl={baseUrl}
    />

    <div class="jm-dossier">
      <header class="jm-header jm-dossier__header">
        <div class="jm-header__inner">
          <button type="button" class="jm-header__loc-btn" data-show-dossier>
            London, UK
          </button>
          <nav class="jm-header__nav" aria-label="Primary">
            <ul>
              <li><a href="#about" data-show-dossier>About</a></li>
              <li><a href="#projects" data-show-dossier>Projects</a></li>
              <li><a href="#experience" data-show-dossier>Experience</a></li>
              <li><a href="#notes" data-show-dossier>Learnings</a></li>
              <li><a href="#contact" data-show-dossier>Contact</a></li>
            </ul>
          </nav>
        </div>
      </header>

      <!-- VIEW 1: MAIN EDITORIAL DOSSIER -->
      <main id="main" class="jm-dossier__body jm-editorial-flow">
        <!-- About -->
        <section id="about" class="jm-chapter jm-chapter--hero">
          <h1 class="jm-hero-title">{profile.headline}</h1>
          <p class="jm-lead-copy">{profile.bio}</p>

          <dl class="jm-now-strip">
            <div class="jm-now-strip__row">
              <dt>Now</dt>
              <dd>{profile.nowLine}</dd>
            </div>
            <div class="jm-now-strip__row">
              <dt>Status</dt>
              <dd>{profile.wipNote}</dd>
            </div>
          </dl>
        </section>

        <!-- Reef Index (Projects) -->
        <section id="projects" class="jm-chapter">
          <div class="jm-chapter__head">
            <h2 class="jm-chapter__title">Reef index</h2>
          </div>

          <div class="jm-stage-tabs" role="region" aria-label="Filter projects by growth stage">
            <button
              type="button"
              class="jm-stage-tab is-active"
              data-stage-filter="all"
              aria-pressed="true"
            >
              <span>All</span>
              <span class="jm-stage-tab__count">{projects.length}</span>
            </button>
            {[...STAGES].reverse().map((stage) => {
              const count = projects.filter((p) => p.stage === stage.id).length;
              return (
                <button
                  type="button"
                  class={`jm-stage-tab${count === 0 ? ' is-empty-stage' : ''}`}
                  data-stage-filter={stage.id}
                  aria-pressed="false"
                >
                  <span>{stage.label}</span>
                  <span class="jm-stage-tab__count">{count}</span>
                </button>
              );
            })}
          </div>

          <div id="project-list" class="jm-reef-cards">
            {projects.map((p) => (
              <button
                type="button"
                class="jm-reef-card"
                data-project-row={p.slug}
                data-stage={p.stage}
              >
                <span class="jm-reef-card__thumb">
                  <img
                    src={p.spriteSrc}
                    alt=""
                    class="jm-pixel-sprite"
                    style="max-height: 44px; max-width: 44px; width: auto; height: auto;"
                  />
                </span>
                <span class="jm-reef-card__body">
                  <span class="jm-reef-card__top">
                    <span class="jm-reef-card__heading">
                      <span class="jm-reef-card__title">{p.title}</span>
                      <span class={`jm-stage-badge jm-stage-badge--${p.stage}`}>
                        <span class="jm-stage-badge__dot" aria-hidden="true"></span>
                        <span>{p.stageLabel}</span>
                      </span>
                    </span>
                    <span class="jm-reef-card__arrow" aria-hidden="true">→</span>
                  </span>
                  <span class="jm-reef-card__desc">{p.summary}</span>
                  <span class="jm-reef-card__meta">
                    <span style="text-transform: capitalize;">{p.species} coral</span>
                    {p.tools.length > 0 && (
                      <span> · {p.tools.slice(0, 3).join(', ')}</span>
                    )}
                  </span>
                </span>
              </button>
            ))}
          </div>

          <div id="project-empty" class="jm-empty-inline is-hidden">
            <p class="jm-secondary-text">No corals in this stage yet. Select another stage above to view the rest of the reef.</p>
          </div>
        </section>

        <!-- Work Experience -->
        <div class="jm-chapter">
          <Experience
            items={experience}
            resumeNote={profile.resumeNote}
          />
        </div>

        <!-- Learnings -->
        <section id="notes" class="jm-chapter">
          <div class="jm-chapter__head">
            <h2 class="jm-chapter__title">Learnings</h2>
          </div>
          <div id="notes-list" class="jm-notes-list">
            {notes.map((n) => {
              const linkedProject = projects.find((p) => p.slug === n.projectSlug);
              return (
                <button
                  type="button"
                  class="jm-note-item"
                  data-note-row={n.slug}
                  data-linked-project={n.projectSlug ?? ''}
                >
                  <span class="jm-note-item__main">
                    <span class="jm-note-item__title">{n.title}</span>
                    <span class="jm-note-item__meta">
                      {n.tag}
                      {linkedProject ? ` · ${linkedProject.title}` : ''}
                    </span>
                  </span>
                  <span class="jm-note-item__date">{n.date}</span>
                </button>
              );
            })}
          </div>
        </section>

        <!-- Contact & Footer -->
        <footer id="contact" class="jm-chapter jm-contact-chapter">
          <div class="jm-chapter__head">
            <h2 class="jm-chapter__title">Get in touch</h2>
          </div>
          <p class="jm-secondary-text">
            Best way to reach me is by email or LinkedIn.
          </p>
          <div class="jm-cluster">
            {profile.email && (
              <button id="copy-email-btn" type="button" class="jm-button">
                Copy email address
              </button>
            )}
            <a
              href={profile.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={profile.email ? 'jm-button jm-button--secondary' : 'jm-button'}
            >
              Open GitHub
            </a>
            {profile.linkedinUrl && (
              <a
                href={profile.linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="jm-button jm-button--secondary"
              >
                Open LinkedIn
              </a>
            )}
          </div>
          <p class="jm-colophon">
            {profile.name} · London · Repo stats last synced {syncedAt}
          </p>
        </footer>
      </main>

      <!-- VIEW 2: INLINE EDITORIAL PROJECT VIEW -->
      <section id="project-detail" class="jm-dossier__body jm-stack jm-stack--loose is-hidden" aria-live="polite">
        <div class="jm-section-head">
          <button type="button" class="jm-back-link" data-show-dossier>
            ← Back to index
          </button>
          <span id="detail-planted" class="jm-secondary-text" style="font-size: var(--jm-font-size-xs);"></span>
        </div>

        <div class="jm-detail-hero">
          <div id="detail-sprite" class="jm-detail-sprite-box"></div>
          <div class="jm-stack jm-stack--tight">
            <div class="jm-cluster">
              <span id="detail-stage-badge" class="jm-stage-badge"></span>
              <span id="detail-species-meta" class="jm-secondary-text" style="font-size: var(--jm-font-size-xs); text-transform: capitalize;"></span>
            </div>
            <h2 id="detail-title" class="jm-detail-title"></h2>
            <p id="detail-tools-line" class="jm-secondary-text" style="font-size: var(--jm-font-size-xs);"></p>
          </div>
        </div>

        <div id="detail-stage-bar" class="jm-stage-grid" aria-label="Growth stage progress"></div>

        <div id="detail-story" class="jm-prose"></div>

        <figure id="detail-figure" class="jm-stack jm-stack--tight is-hidden" style="margin: 0;">
          <img id="detail-figure-img" src="" alt="" style="width: 100%; border-radius: var(--jm-radius-sm); border: 1px solid var(--jm-colour-border);" />
          <figcaption id="detail-figure-caption" class="jm-secondary-text" style="font-size: var(--jm-font-size-xs);"></figcaption>
        </figure>

        <div id="detail-takeaways-wrap" class="jm-stack jm-stack--tight">
          <h3>Lessons</h3>
          <ul id="detail-takeaways" class="jm-takeaways"></ul>
        </div>

        <div id="detail-github-wrap" class="jm-stack jm-stack--tight is-hidden">
          <h3>Repository</h3>
          <dl id="detail-github" class="jm-summary-list jm-summary-list--no-actions"></dl>
        </div>

        <div id="detail-note-wrap" class="is-hidden"></div>
        <div id="detail-actions" class="jm-cluster"></div>
      </section>

      <!-- VIEW 3: INLINE FIELD NOTE READER -->
      <section id="note-detail" class="jm-dossier__body jm-stack jm-stack--loose is-hidden" aria-live="polite">
        <div class="jm-section-head">
          <button type="button" class="jm-back-link" data-show-dossier>
            ← Back to index
          </button>
          <a id="note-permalink" href="#" class="jm-secondary-text" style="font-size: var(--jm-font-size-xs);">Permalink</a>
        </div>
        <div class="jm-stack jm-stack--tight">
          <span id="note-meta" class="jm-secondary-text" style="font-size: var(--jm-font-size-xs);"></span>
          <h2 id="note-title" class="jm-detail-title"></h2>
        </div>
        <div id="note-body" class="jm-prose"></div>
        <div id="note-linked" class="jm-section-head" style="padding-top: var(--jm-space-4); border-top: 1px solid var(--jm-colour-border);"></div>
      </section>
    </div>
  </div>

  <div id="toast" class="jm-toast is-hidden" role="status" aria-live="polite"></div>

  <script id="reef-data" type="application/json" set:html={JSON.stringify(clientPayload)}></script>

  <script>
    const rawData = document.getElementById('reef-data')?.textContent || '{}';
    const DATA = JSON.parse(rawData);
    const PROJECTS = DATA.projects || [];
    const NOTES = DATA.notes || [];
    const STAGES = DATA.stages || [];
    const EMAIL = DATA.email || '';
    const BASE_URL = DATA.baseUrl || '/';

    let currentTheme = 'light';
    let showLabels = true;
    let activeStage = 'all';
    let hoveredSlug = null;
    let selectedSlug = null;

    const rootEl = document.documentElement;
    const reefPaneEl = document.getElementById('reef-pane');
    const mainViewEl = document.getElementById('main');
    const detailViewEl = document.getElementById('project-detail');
    const noteViewEl = document.getElementById('note-detail');
    const captionEl = document.getElementById('reef-caption');
    const emptyEl = document.getElementById('project-empty');

    function matchesFilters(project) {
      return activeStage === 'all' || project.stage === activeStage;
    }

    function syncReefHighlight() {
      document.querySelectorAll('.jm-coral-node').forEach((node) => {
        const slug = node.getAttribute('data-slug');
        const project = PROJECTS.find((item) => item.slug === slug);
        if (!project) return;
        const matches = matchesFilters(project);
        const isSel = selectedSlug === slug;
        const isHov = hoveredSlug === slug;
        node.classList.toggle('is-selected', isSel);
        node.classList.toggle('is-highlighted', isHov);
        const dimForFocus = (hoveredSlug && !isHov && !isSel) || (selectedSlug && !isSel && !isHov);
        node.classList.toggle('is-dimmed', !matches || Boolean(dimForFocus));
      });

      const focusSlug = hoveredSlug || selectedSlug;
      if (focusSlug && captionEl) {
        const project = PROJECTS.find((item) => item.slug === focusSlug);
        if (project) {
          captionEl.textContent = `${project.title} · ${project.stageLabel}`;
        }
      } else if (captionEl) {
        const count = PROJECTS.filter(matchesFilters).length;
        captionEl.textContent =
          count === PROJECTS.length
            ? 'Click a coral'
            : `Showing ${count} of ${PROJECTS.length} corals`;
      }
    }

    function applyFilters() {
      let visibleCount = 0;
      document.querySelectorAll('[data-project-row]').forEach((row) => {
        const slug = row.getAttribute('data-project-row');
        const project = PROJECTS.find((item) => item.slug === slug);
        const visible = project ? matchesFilters(project) : false;
        row.classList.toggle('is-hidden', !visible);
        if (visible) visibleCount += 1;
      });

      emptyEl?.classList.toggle('is-hidden', visibleCount > 0);

      document.querySelectorAll('[data-stage-filter]').forEach((btn) => {
        const val = btn.getAttribute('data-stage-filter');
        const active = val === activeStage;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', String(active));
      });

      syncReefHighlight();
    }

    function showMainDossier() {
      selectedSlug = null;
      mainViewEl?.classList.remove('is-hidden');
      detailViewEl?.classList.add('is-hidden');
      noteViewEl?.classList.add('is-hidden');
      syncReefHighlight();
    }

    function openProjectDetail(slug) {
      const p = PROJECTS.find((item) => item.slug === slug);
      if (!p) return;
      selectedSlug = slug;

      const setText = (id, text) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };

      setText('detail-planted', `Started ${p.plantedDate}`);
      const spriteBox = document.getElementById('detail-sprite');
      if (spriteBox) {
        spriteBox.innerHTML = `<img src="${p.spriteSrc}" alt="${p.title} coral sprite" class="jm-pixel-sprite" style="max-height: 68px; max-width: 68px; width: auto; height: auto;" />`;
      }

      const stageBadge = document.getElementById('detail-stage-badge');
      if (stageBadge) {
        stageBadge.className = `jm-stage-badge jm-stage-badge--${p.stage}`;
        stageBadge.innerHTML = `<span class="jm-stage-badge__dot" aria-hidden="true"></span><span>${p.stageLabel}</span>`;
      }

      setText('detail-species-meta', `${p.species} coral`);
      setText('detail-title', p.title);
      setText('detail-tools-line', (p.tools || []).join(' · '));

      const stageIds = ['polyp', 'bud', 'branch', 'reef'];
      const activeIdx = stageIds.indexOf(p.stage);
      const stageBar = document.getElementById('detail-stage-bar');
      if (stageBar) {
        stageBar.innerHTML = STAGES.map(
          (st, i) => `<div class="jm-stage-step ${i <= activeIdx ? 'is-active' : ''}">${st.label}</div>`
        ).join('');
      }

      const storyEl = document.getElementById('detail-story');
      if (storyEl) {
        const paras = p.paragraphs && p.paragraphs.length ? p.paragraphs : [p.summary];
        storyEl.innerHTML = paras.map((para) => `<p>${para}</p>`).join('');
      }

      const figureEl = document.getElementById('detail-figure');
      const figureImg = document.getElementById('detail-figure-img');
      const figureCap = document.getElementById('detail-figure-caption');
      if (figureEl && figureImg && figureCap) {
        if (p.screenshotImage) {
          figureImg.setAttribute('src', `${BASE_URL}${p.screenshotImage.replace(/^\//, '')}`);
          figureImg.setAttribute('alt', p.screenshotCaption || `${p.title} screenshot`);
          figureCap.textContent = p.screenshotCaption || '';
          figureEl.classList.remove('is-hidden');
        } else {
          figureEl.classList.add('is-hidden');
        }
      }

      const takeawaysWrap = document.getElementById('detail-takeaways-wrap');
      const takeawaysEl = document.getElementById('detail-takeaways');
      if (takeawaysWrap && takeawaysEl) {
        if (p.takeaways && p.takeaways.length) {
          takeawaysWrap.classList.remove('is-hidden');
          takeawaysEl.innerHTML = p.takeaways.map((t) => `<li>${t}</li>`).join('');
        } else {
          takeawaysWrap.classList.add('is-hidden');
        }
      }

      const ghWrap = document.getElementById('detail-github-wrap');
      const ghEl = document.getElementById('detail-github');
      if (ghWrap && ghEl) {
        if (p.githubRepo && p.githubMeta) {
          ghWrap.classList.remove('is-hidden');
          ghEl.innerHTML = `
            <div class="jm-summary-list__row"><dt>Repository</dt><dd>${p.githubRepo}</dd></div>
            <div class="jm-summary-list__row"><dt>Primary language</dt><dd>${p.githubMeta.primaryLang}</dd></div>
            <div class="jm-summary-list__row"><dt>Last updated</dt><dd>${p.githubMeta.lastPush}</dd></div>
            <div class="jm-summary-list__row"><dt>Activity</dt><dd>${p.githubMeta.commits} · ${p.githubMeta.stars}</dd></div>
          `;
        } else if (p.githubRepo) {
          ghWrap.classList.remove('is-hidden');
          ghEl.innerHTML = `
            <div class="jm-summary-list__row"><dt>Repository</dt><dd>${p.githubRepo}</dd></div>
          `;
        } else {
          ghWrap.classList.add('is-hidden');
        }
      }

      const noteWrap = document.getElementById('detail-note-wrap');
      const linkedNote = NOTES.find((n) => n.slug === p.relatedNote);
      if (noteWrap) {
        if (linkedNote) {
          noteWrap.classList.remove('is-hidden');
          noteWrap.innerHTML = `
            <div class="jm-related-note">
              <span><strong>Related learning:</strong> ${linkedNote.title}</span>
              <button type="button" class="jm-back-link" data-open-note="${linkedNote.slug}">
                Read →
              </button>
            </div>
          `;
          noteWrap.querySelector('[data-open-note]')?.addEventListener('click', () => {
            openNoteDetail(linkedNote.slug);
          });
        } else {
          noteWrap.classList.add('is-hidden');
          noteWrap.innerHTML = '';
        }
      }

      const actionsEl = document.getElementById('detail-actions');
      if (actionsEl) {
        const actions = [];
        if (p.githubRepo) {
          const repoUrl = p.githubMeta?.htmlUrl || `https://github.com/${p.githubRepo}`;
          actions.push(
            `<a href="${repoUrl}" target="_blank" rel="noopener noreferrer" class="jm-button">Open GitHub repository</a>`
          );
        }
        if (p.demoUrl) {
          actions.push(
            `<a href="${p.demoUrl}" target="_blank" rel="noopener noreferrer" class="jm-button jm-button--secondary">Open live site</a>`
          );
        }
        if (!actions.length) {
          actions.push(
            `<span class="jm-secondary-text" style="font-size: var(--jm-font-size-sm);">Private repository.</span>`
          );
        }
        actionsEl.innerHTML = actions.join('');
      }

      mainViewEl?.classList.add('is-hidden');
      noteViewEl?.classList.add('is-hidden');
      detailViewEl?.classList.remove('is-hidden');
      syncReefHighlight();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function openNoteDetail(slug) {
      const note = NOTES.find((item) => item.slug === slug);
      if (!note) return;
      selectedSlug = note.projectSlug;

      const proj = PROJECTS.find((p) => p.slug === note.projectSlug);
      const metaEl = document.getElementById('note-meta');
      const titleEl = document.getElementById('note-title');
      const bodyEl = document.getElementById('note-body');
      const linkedEl = document.getElementById('note-linked');
      const permalinkEl = document.getElementById('note-permalink');

      if (metaEl) metaEl.textContent = `${note.date} · ${note.tag}`;
      if (titleEl) titleEl.textContent = note.title;
      if (permalinkEl) permalinkEl.setAttribute('href', `${BASE_URL}notes/${note.slug}/`);
      if (bodyEl) {
        bodyEl.innerHTML = note.paragraphs
          .map((para) => `<p>${para}</p>`)
          .join('');
      }

      if (linkedEl) {
        if (proj) {
          linkedEl.innerHTML = `
            <span class="jm-secondary-text" style="font-size: var(--jm-font-size-sm);">Linked project</span>
            <button type="button" class="jm-back-link" data-open-project="${proj.slug}">
              Inspect ${proj.title} →
            </button>
          `;
          linkedEl.querySelector('[data-open-project]')?.addEventListener('click', () => {
            openProjectDetail(proj.slug);
          });
        } else {
          linkedEl.innerHTML = '';
        }
      }

      mainViewEl?.classList.add('is-hidden');
      detailViewEl?.classList.add('is-hidden');
      noteViewEl?.classList.remove('is-hidden');
      syncReefHighlight();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    let toastTimer;
    function showToast(msg) {
      const el = document.getElementById('toast');
      if (!el) return;
      el.textContent = msg;
      el.classList.remove('is-hidden');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.add('is-hidden'), 2400);
    }

    // Bind coral nodes
    document.querySelectorAll('.jm-coral-node').forEach((node) => {
      const slug = node.getAttribute('data-slug');
      node.addEventListener('click', () => slug && openProjectDetail(slug));
      node.addEventListener('mouseenter', () => {
        hoveredSlug = slug;
        syncReefHighlight();
      });
      node.addEventListener('mouseleave', () => {
        hoveredSlug = null;
        syncReefHighlight();
      });
    });

    // Bind project rows
    document.querySelectorAll('[data-project-row]').forEach((row) => {
      const slug = row.getAttribute('data-project-row');
      row.addEventListener('click', () => slug && openProjectDetail(slug));
      row.addEventListener('mouseenter', () => {
        hoveredSlug = slug;
        syncReefHighlight();
      });
      row.addEventListener('mouseleave', () => {
        hoveredSlug = null;
        syncReefHighlight();
      });
    });

    // Bind note rows
    document.querySelectorAll('[data-note-row]').forEach((row) => {
      const slug = row.getAttribute('data-note-row');
      const linked = row.getAttribute('data-linked-project') || null;
      row.addEventListener('click', () => slug && openNoteDetail(slug));
      row.addEventListener('mouseenter', () => {
        hoveredSlug = linked;
        syncReefHighlight();
      });
      row.addEventListener('mouseleave', () => {
        hoveredSlug = null;
        syncReefHighlight();
      });
    });

    // Bind dossier return triggers
    document.querySelectorAll('[data-show-dossier]').forEach((el) => {
      el.addEventListener('click', () => showMainDossier());
    });

    // Bind stage filters
    document.querySelectorAll('[data-stage-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeStage = btn.getAttribute('data-stage-filter') || 'all';
        applyFilters();
      });
    });

    // Day / Night toggle
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle?.addEventListener('click', () => {
      currentTheme = currentTheme === 'light' ? 'dark' : 'light';
      rootEl.setAttribute('data-theme', currentTheme);
      themeToggle.textContent = currentTheme === 'light' ? 'Switch to night' : 'Switch to day';
      themeToggle.setAttribute('aria-pressed', String(currentTheme === 'dark'));
    });

    // Labels toggle
    const labelsToggle = document.getElementById('labels-toggle');
    labelsToggle?.addEventListener('click', () => {
      showLabels = !showLabels;
      reefPaneEl?.classList.toggle('labels-off', !showLabels);
      labelsToggle.textContent = showLabels ? 'Hide labels' : 'Show labels';
      labelsToggle.setAttribute('aria-pressed', String(showLabels));
    });

    // Copy email
    document.getElementById('copy-email-btn')?.addEventListener('click', () => {
      if (EMAIL && navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(EMAIL).catch(() => {});
      }
      if (EMAIL) showToast(`Copied ${EMAIL} to clipboard`);
    });

    applyFilters();
  </script>
</BaseLayout>

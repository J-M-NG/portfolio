---
import '../styles/ui-kit.css';
import '../styles/reef.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Project Reef — a living pixel coral reef portfolio of product management and vibecoded prototypes.',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${baseUrl}sprites/staghorn-reef.png`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="jm-skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

---
interface ExperienceItem {
  period: string;
  role: string;
  company: string;
  location?: string;
  summary: string;
}

interface Props {
  items: ExperienceItem[];
  bannerTitle: string;
  bannerBody: string;
}

const { items, bannerTitle, bannerBody } = Astro.props;
---

<section id="experience" class="jm-stack">
  <h2>Work experience</h2>

  <div class="jm-banner" role="region" aria-label={bannerTitle}>
    <p class="jm-banner__title">{bannerTitle}</p>
    <p>
      {bannerBody} <a href="#contact">Go to contact details</a>.
    </p>
  </div>

  {items.length > 0 && (
    <ol class="jm-trail">
      {items.map((item) => (
        <li>
          <time>{item.period}</time>
          <div class="jm-stack jm-stack--tight">
            <div>
              <strong>{item.role}</strong>, {item.company}
              {item.location && <span class="jm-secondary-text"> ({item.location})</span>}
            </div>
            <p class="jm-secondary-text">{item.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  )}

  <div class="jm-stack jm-stack--tight">
    <h3>Education</h3>
    <dl class="jm-summary-list jm-summary-list--no-actions">
      <div class="jm-summary-list__row">
        <dt>LSE</dt>
        <dd>MSc in Management (Distinction)</dd>
      </div>
      <div class="jm-summary-list__row">
        <dt>Imperial College London</dt>
        <dd>BSc in Biochemistry with a Placement in Industry</dd>
      </div>
    </dl>
  </div>
</section>

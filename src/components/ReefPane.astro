---
import { getCoralSpritePath, getStageMeta, type CoralStage, type CoralSpecies, type SpriteVariant } from '../lib/reef';

export interface ReefProjectItem {
  slug: string;
  title: string;
  stage: CoralStage;
  species: CoralSpecies;
  spriteVariant: SpriteVariant;
  posX: number;
  posY: number;
}

interface Props {
  projects: ReefProjectItem[];
  baseUrl: string;
}

const { projects, baseUrl } = Astro.props;
const prefix = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const sortedProjects = [...projects].sort((a, b) => a.posY - b.posY);

function getDepthScale(posY: number): string {
  const clamped = Math.max(68, Math.min(92, posY));
  const scale = 0.88 + ((clamped - 68) / 24) * 0.2;
  return scale.toFixed(2);
}

function getDepthLayer(posY: number): 'far' | 'mid' | 'near' {
  if (posY < 76) return 'far';
  if (posY < 83) return 'mid';
  return 'near';
}
---

<aside id="reef-pane" class="jm-reef" aria-label="Interactive project coral reef">
  <!-- Hand-styled 16-bit Pixel-Art Cove Backgrounds (Day & Night cross-fade) -->
  <img
    src={`${prefix}sprites/bg-reef-day.jpg`}
    alt=""
    class="jm-reef__bg jm-reef__bg--day"
    aria-hidden="true"
  />
  <img
    src={`${prefix}sprites/bg-reef-night.jpg`}
    alt=""
    class="jm-reef__bg jm-reef__bg--night"
    aria-hidden="true"
  />

  <!-- Seabed Accents (blended naturally onto the open sandy cove) -->
  <div class="jm-reef__props" aria-hidden="true">
    <img
      src={`${prefix}sprites/prop-seagrass.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop jm-reef-prop--seagrass"
      style="left: 9%; top: 78%; height: 56px; width: auto;"
    />
    <img
      src={`${prefix}sprites/prop-seagrass.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop jm-reef-prop--seagrass"
      style="left: 91%; top: 82%; height: 52px; width: auto; animation-delay: -2.4s;"
    />
    <img
      src={`${prefix}sprites/prop-pearl-clam.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop jm-reef-prop--clam"
      style="left: 68%; top: 75%; height: 42px; width: auto;"
    />
    <img
      src={`${prefix}sprites/prop-bottle.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop jm-reef-prop--bottle"
      style="left: 72%; top: 91%; height: 34px; width: auto;"
    />
  </div>

  <!-- Calm, Deliberate Sea Life -->
  <div class="jm-reef__critters" aria-hidden="true">
    <!-- Hero Gliding Sea Turtle -->
    <div class="jm-critter-track jm-critter-track--turtle" style="top: 17%; left: 10%;">
      <img
        src={`${prefix}sprites/critter-turtle.png`}
        alt=""
        class="jm-pixel-sprite jm-critter-img--turtle"
        style="height: 48px; width: auto;"
      />
    </div>

    <!-- Pulsing Bioluminescent Jellyfish -->
    <div class="jm-critter-track jm-critter-track--jellyfish" style="top: 24%; left: 76%;">
      <img
        src={`${prefix}sprites/critter-jellyfish.png`}
        alt=""
        class="jm-pixel-sprite jm-critter-img--jellyfish"
        style="height: 46px; width: auto;"
      />
    </div>

    <!-- Gentle Clownfish near the Anemone & Corals -->
    <div class="jm-critter-track jm-critter-track--clownfish" style="top: 53%; left: 66%;">
      <img
        src={`${prefix}sprites/critter-clownfish.png`}
        alt=""
        class="jm-pixel-sprite"
        style="height: 24px; width: auto;"
      />
    </div>

    <!-- Resting Foreground Hermit Crab -->
    <div class="jm-critter-track jm-critter-track--crab" style="top: 90%; left: 56%;">
      <img
        src={`${prefix}sprites/critter-crab.png`}
        alt=""
        class="jm-pixel-sprite"
        style="height: 30px; width: auto;"
      />
    </div>
  </div>

  <!-- Sparse, Slow Rising Bubbles -->
  <div class="jm-bubble" style="bottom: 22%; left: 26%; animation-delay: 0s;" aria-hidden="true"></div>
  <div class="jm-bubble" style="bottom: 26%; left: 58%; animation-delay: 3.1s; width: 5px; height: 5px;" aria-hidden="true"></div>
  <div class="jm-bubble" style="bottom: 18%; left: 79%; animation-delay: 5.4s; width: 4px; height: 4px;" aria-hidden="true"></div>

  <!-- Night Bioluminescent Plankton -->
  <div class="night-only" aria-hidden="true">
    <div class="jm-plankton" style="top: 38%; left: 22%; animation-delay: 0s;"></div>
    <div class="jm-plankton" style="top: 52%; left: 48%; animation-delay: 1.8s;"></div>
    <div class="jm-plankton" style="top: 44%; left: 74%; animation-delay: 3.2s;"></div>
  </div>

  <!-- Floating Controls (Solid Crisp Surfaces) -->
  <div class="jm-reef__hud">
    <button
      id="theme-toggle"
      type="button"
      class="jm-reef-pill"
      aria-label="Switch between sunlit day and bioluminescent night"
      aria-pressed="false"
    >
      Switch to night
    </button>
    <button
      id="labels-toggle"
      type="button"
      class="jm-reef-pill"
      aria-pressed="true"
    >
      Hide labels
    </button>
  </div>

  <!-- Interactive Project Corals -->
  <div id="reef-corals" class="jm-reef__corals">
    {sortedProjects.map((project, idx) => {
      const stageMeta = getStageMeta(project.stage);
      const spriteSrc = getCoralSpritePath(project.stage, project.species, project.spriteVariant, baseUrl);
      const z = Math.round(project.posY / 2);
      const shouldSway = project.stage === 'reef' || project.stage === 'branch';
      const depthScale = getDepthScale(project.posY);
      const depthLayer = getDepthLayer(project.posY);
      return (
        <button
          type="button"
          class={`jm-coral-node jm-coral-node--${depthLayer}`}
          data-slug={project.slug}
          style={`left: ${project.posX}%; top: ${project.posY}%; z-index: ${z}; --depth-scale: ${depthScale};`}
          aria-label={`${project.title} (${stageMeta.label})`}
        >
          <span class="jm-coral-node__ring" aria-hidden="true"></span>
          <span
            class={`jm-coral-node__sprite-wrap${shouldSway ? ' jm-sway' : ''}`}
            style={`animation-delay: -${((idx * 0.9) % 4).toFixed(1)}s;`}
          >
            <img
              src={spriteSrc}
              alt=""
              class="jm-pixel-sprite"
              style={`height: ${stageMeta.displayHeight}px; width: auto;`}
              loading="eager"
            />
          </span>
          <span class="jm-coral-node__tag">{project.title}</span>
        </button>
      );
    })}
  </div>

  <!-- Bottom Status Caption -->
  <div class="jm-reef__caption">
    <div class="jm-reef-pill jm-reef-pill--static">
      <span id="reef-caption">Click a coral</span>
    </div>
  </div>
</aside>

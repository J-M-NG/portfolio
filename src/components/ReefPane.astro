---
import { getCoralSpritePath, getStageMeta, type CoralStage, type CoralSpecies, type SpriteVariant } from '../lib/reef';

export interface ReefProjectItem {
  slug: string;
  title: string;
  stage: CoralStage;
  species: CoralSpecies;
  spriteVariant: SpriteVariant;
  posX: number;
  posY: number;
}

interface Props {
  projects: ReefProjectItem[];
  baseUrl: string;
}

const { projects, baseUrl } = Astro.props;
const prefix = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const sortedProjects = [...projects].sort((a, b) => a.posY - b.posY);

function getDepthScale(posY: number): string {
  const clamped = Math.max(58, Math.min(92, posY));
  const scale = 0.84 + ((clamped - 58) / 34) * 0.24;
  return scale.toFixed(2);
}

function getDepthLayer(posY: number): 'far' | 'mid' | 'near' {
  if (posY < 70) return 'far';
  if (posY < 81) return 'mid';
  return 'near';
}
---

<aside id="reef-pane" class="jm-reef" aria-label="Interactive project coral reef">
  <!-- Animated Surface Caustics -->
  <div class="jm-reef__surface-shimmer" aria-hidden="true"></div>

  <!-- Rich 16-bit Pixel-Art Underwater Backdrop SVG -->
  <svg
    class="jm-reef__backdrop"
    viewBox="0 0 320 380"
    preserveAspectRatio="none"
    shape-rendering="crispEdges"
    aria-hidden="true"
  >
    <defs>
      <!-- Soft volumetric sunbeam / moonbeam gradients -->
      <linearGradient id="rayGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--ray-top)" />
        <stop offset="55%" stop-color="var(--ray-mid)" />
        <stop offset="100%" stop-color="var(--ray-fade)" />
      </linearGradient>

      <!-- Water-to-seabed depth gradient for subtle underwater mist -->
      <linearGradient id="waterHazeGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--sea-mid)" stop-opacity="0" />
        <stop offset="70%" stop-color="var(--sea-deep)" stop-opacity="0.22" />
        <stop offset="100%" stop-color="var(--sea-deep)" stop-opacity="0.45" />
      </linearGradient>

      <!-- Authentic 16-bit pixel dithering pattern for sand grain -->
      <pattern id="sandDitherLight" width="8" height="8" patternUnits="userSpaceOnUse">
        <rect x="0" y="0" width="2" height="2" fill="var(--sand-highlight)" opacity="0.28" />
        <rect x="4" y="2" width="2" height="2" fill="var(--sand-highlight)" opacity="0.2" />
        <rect x="2" y="6" width="2" height="2" fill="var(--sand-2)" opacity="0.25" />
        <rect x="6" y="4" width="2" height="2" fill="var(--sand-2)" opacity="0.22" />
      </pattern>

      <pattern id="sandDitherDeep" width="8" height="8" patternUnits="userSpaceOnUse">
        <rect x="0" y="2" width="2" height="2" fill="var(--sand-ripple)" opacity="0.32" />
        <rect x="4" y="0" width="2" height="2" fill="var(--sand-2)" opacity="0.24" />
        <rect x="2" y="6" width="2" height="2" fill="var(--sand-ripple)" opacity="0.28" />
        <rect x="6" y="4" width="2" height="2" fill="var(--sand-1)" opacity="0.14" />
      </pattern>

      <!-- Subtle water pixel-dither texture -->
      <pattern id="waterDither" width="12" height="12" patternUnits="userSpaceOnUse">
        <rect x="2" y="2" width="2" height="2" fill="rgba(255,255,255,0.06)" />
        <rect x="8" y="6" width="2" height="2" fill="rgba(255,255,255,0.04)" />
        <rect x="4" y="10" width="2" height="2" fill="rgba(0,20,40,0.05)" />
      </pattern>
    </defs>

    <!-- Subtle Water Dither Texture -->
    <rect x="0" y="0" width="320" height="250" fill="url(#waterDither)" />

    <!-- Pixel-Stepped Water Surface Waves & Underside Shimmer -->
    <g class="jm-surface-waves">
      <rect x="0" y="0" width="320" height="4" fill="rgba(255,255,255,0.28)" />
      <rect x="0" y="4" width="52" height="3" fill="rgba(255,255,255,0.22)" />
      <rect x="68" y="4" width="76" height="3" fill="rgba(255,255,255,0.26)" />
      <rect x="164" y="4" width="64" height="3" fill="rgba(255,255,255,0.2)" />
      <rect x="244" y="4" width="76" height="3" fill="rgba(255,255,255,0.24)" />
      <rect x="16" y="8" width="44" height="2" fill="rgba(255,255,255,0.34)" />
      <rect x="92" y="9" width="58" height="2" fill="rgba(255,255,255,0.28)" />
      <rect x="188" y="8" width="48" height="2" fill="rgba(255,255,255,0.3)" />
      <rect x="262" y="10" width="42" height="2" fill="rgba(255,255,255,0.26)" />
      <rect x="42" y="13" width="26" height="2" fill="rgba(255,255,255,0.18)" />
      <rect x="148" y="14" width="32" height="2" fill="rgba(255,255,255,0.16)" />
      <rect x="234" y="15" width="24" height="2" fill="rgba(255,255,255,0.18)" />
    </g>

    <!-- Volumetric Diagonal Sunbeams / Moonlight Shafts -->
    <g class="jm-sunbeams">
      <polygon points="18,0 78,0 32,272 -18,272" fill="url(#rayGrad)" />
      <polygon points="108,0 184,0 132,295 66,295" fill="url(#rayGrad)" />
      <polygon points="216,0 288,0 242,286 184,286" fill="url(#rayGrad)" />
      <polygon points="140,0 162,0 124,250 104,250" fill="url(#rayGrad)" opacity="0.65" />
    </g>

    <!-- LAYER 1: Far Misty Reef Ridges, Coral Spires & Distant Table Corals -->
    <g fill="var(--reef-far)" opacity="0.52">
      <polygon points="0,232 0,180 14,180 14,170 28,170 28,162 46,162 46,156 64,156 64,166 78,166 78,176 96,176 96,184 118,184 118,172 136,172 136,164 156,164 156,170 176,170 176,182 198,182 198,188 220,188 220,174 242,174 242,160 264,160 264,152 282,152 282,164 298,164 298,174 320,174 320,232" />
      <!-- Far table coral & spire silhouettes -->
      <rect x="34" y="150" width="24" height="4" />
      <rect x="44" y="154" width="6" height="8" />
      <rect x="138" y="156" width="18" height="3" />
      <rect x="145" y="159" width="4" height="6" />
      <rect x="266" y="144" width="14" height="4" />
      <rect x="271" y="148" width="4" height="6" />
    </g>

    <!-- LAYER 2: Mid-Distance Reef Shelves, Rocky Outcrops & Silhouetted Kelp -->
    <g fill="var(--reef-mid)" opacity="0.72">

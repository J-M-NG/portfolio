      <!-- Distant silhouetted kelp stalks -->
      <rect x="10" y="176" width="3" height="30" />
      <rect x="8" y="182" width="2" height="6" />
      <rect x="13" y="188" width="2" height="8" />
      <rect x="304" y="180" width="3" height="28" />
      <rect x="301" y="186" width="3" height="6" />

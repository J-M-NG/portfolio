---
import { getCoralSpritePath, getStageMeta, type CoralStage, type CoralSpecies, type SpriteVariant } from '../lib/reef';

export interface ReefProjectItem {
  slug: string;
  title: string;
  stage: CoralStage;
  species: CoralSpecies;
  spriteVariant: SpriteVariant;
  posX: number;
  posY: number;
}

interface Props {
  projects: ReefProjectItem[];
  baseUrl: string;
}

const { projects, baseUrl } = Astro.props;
const prefix = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const sortedProjects = [...projects].sort((a, b) => a.posY - b.posY);

function getDepthScale(posY: number): string {
  const clamped = Math.max(58, Math.min(92, posY));
  const scale = 0.84 + ((clamped - 58) / 34) * 0.24;
  return scale.toFixed(2);
}

function getDepthLayer(posY: number): 'far' | 'mid' | 'near' {
  if (posY < 70) return 'far';
  if (posY < 81) return 'mid';
  return 'near';
}
---

<aside id="reef-pane" class="jm-reef" aria-label="Interactive project coral reef">
  <!-- Animated Surface Caustics -->
  <div class="jm-reef__surface-shimmer" aria-hidden="true"></div>

  <!-- Underwater Backdrop SVG: Layered Reef Silhouettes, Sunbeams & Organic Terraced Seabed -->
  <svg
    class="jm-reef__backdrop"
    viewBox="0 0 640 760"
    preserveAspectRatio="none"
    shape-rendering="crispEdges"
    aria-hidden="true"
  >
    <!-- Water surface shimmer pixels -->
    <rect x="0" y="0" width="640" height="10" fill="rgba(255,255,255,0.16)" />
    <rect x="24" y="14" width="96" height="4" fill="rgba(255,255,255,0.22)" />
    <rect x="196" y="10" width="144" height="4" fill="rgba(255,255,255,0.18)" />
    <rect x="424" y="16" width="128" height="4" fill="rgba(255,255,255,0.2)" />
    <rect x="572" y="12" width="52" height="4" fill="rgba(255,255,255,0.16)" />

    <!-- Soft Diagonal Sunbeams / Moonlight Shafts -->
    <g class="jm-sunbeams">
      <polygon points="48,0 164,0 76,520 -20,520" fill="var(--ray-color)" />
      <polygon points="248,0 388,0 278,560 156,560" fill="var(--ray-color)" />
      <polygon points="472,0 596,0 496,540 392,540" fill="var(--ray-color)" />
    </g>

    <!-- Distant Reef Silhouette Ridge (Far Haze) -->
    <polygon
      points="0,420 0,348 36,348 36,332 84,332 84,320 148,320 148,336 192,336 192,356 256,356 256,340 316,340 316,328 384,328 384,344 440,344 440,360 496,360 496,324 568,324 568,312 612,312 612,336 640,336 640,420"
      fill="var(--reef-far)"
      opacity="0.48"
    />

    <!-- Mid-Distance Reef Shelf -->
    <polygon
      points="0,476 0,416 52,416 52,400 124,400 124,392 184,392 184,412 244,412 244,428 336,428 336,412 412,412 412,396 488,396 488,408 552,408 552,424 640,424 640,476"
      fill="var(--reef-mid)"
      opacity="0.62"
    />

    <!-- Back Reef Terrace Slope (Water-to-Sand Soft Blend Band) -->
    <polygon
      points="0,504 0,468 72,468 72,456 168,456 168,464 268,464 268,480 376,480 376,472 476,472 476,460 564,460 564,468 640,468 640,504"
      fill="var(--sand-haze)"
      opacity="0.72"
    />

    <!-- Organic Pixel-Stepped Sandy Seabed (Upper Sunlit Terrace) -->
    <polygon
      points="0,760 0,484 60,484 60,476 156,476 156,484 236,484 236,496 320,496 320,504 408,504 408,492 496,492 496,480 576,480 576,488 640,488 640,760"
      fill="var(--sand-1)"
    />

    <!-- Sunlit Sand Crest Highlights -->
    <rect x="64" y="480" width="88" height="6" fill="var(--sand-highlight)" opacity="0.55" />
    <rect x="498" y="484" width="76" height="6" fill="var(--sand-highlight)" opacity="0.5" />
    <rect x="244" y="502" width="112" height="6" fill="var(--sand-highlight)" opacity="0.42" />

    <!-- Mid-Slope Sand Dune Contour -->
    <polygon
      points="0,760 0,564 88,564 88,556 184,556 184,568 276,568 276,580 392,580 392,568 488,568 488,556 572,556 572,564 640,564 640,760"
      fill="var(--sand-2)"
      opacity="0.72"
    />

    <!-- Foreground Sand Terrace -->
    <polygon
      points="0,760 0,664 112,664 112,656 228,656 228,668 356,668 356,676 476,676 476,660 584,660 584,668 640,668 640,760"
      fill="var(--sand-3)"
      opacity="0.74"
    />

    <!-- Pixel-Dithered Sand Ripples & Pebbles -->
    <g fill="var(--sand-ripple)" opacity="0.55">
      <rect x="52" y="520" width="44" height="4" />
      <rect x="64" y="524" width="20" height="4" />
      <rect x="224" y="538" width="56" height="4" />
      <rect x="456" y="526" width="48" height="4" />
      <rect x="136" y="608" width="52" height="4" />
      <rect x="332" y="620" width="64" height="4" />
      <rect x="512" y="604" width="44" height="4" />
      <rect x="208" y="696" width="60" height="4" />
      <rect x="424" y="704" width="52" height="4" />
    </g>

    <!-- Subtle Caustic Light Ribbons on the Sand -->
    <g class="jm-sand-caustics" fill="var(--caustic-color)">
      <rect x="88" y="508" width="40" height="4" />
      <rect x="116" y="512" width="24" height="4" />
      <rect x="292" y="548" width="48" height="4" />
      <rect x="488" y="516" width="36" height="4" />
      <rect x="184" y="636" width="44" height="4" />
      <rect x="384" y="644" width="52" height="4" />
    </g>
  </svg>

  <!-- Seabed Landmarks & Props -->
  <div class="jm-reef__props" aria-hidden="true">
    <img
      src={`${prefix}sprites/prop-rock-arch.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop jm-reef-prop--arch"
      style="left: 44%; top: 61%; height: 142px; width: auto;"
    />
    <img
      src={`${prefix}sprites/prop-reef-boulder.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop jm-reef-prop--far"
      style="left: 11%; top: 66%; height: 62px; width: auto;"
    />
    <img
      src={`${prefix}sprites/prop-reef-boulder.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop"
      style="left: 88%; top: 75%; height: 58px; width: auto;"
    />
    <img
      src={`${prefix}sprites/prop-seagrass.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop jm-reef-prop--seagrass"
      style="left: 7%; top: 77%; height: 60px; width: auto;"
    />
    <img
      src={`${prefix}sprites/prop-seagrass.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop jm-reef-prop--seagrass"
      style="left: 93%; top: 82%; height: 56px; width: auto; animation-delay: -2.2s;"
    />
    <img
      src={`${prefix}sprites/prop-seagrass.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop jm-reef-prop--seagrass jm-reef-prop--far"
      style="left: 31%; top: 65%; height: 42px; width: auto; animation-delay: -1.1s;"
    />
    <img
      src={`${prefix}sprites/prop-pearl-clam.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop jm-reef-prop--clam"
      style="left: 65%; top: 71%; height: 46px; width: auto;"
    />
    <img
      src={`${prefix}sprites/prop-starfish-shell.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop"
      style="left: 86%; top: 91%; height: 38px; width: auto;"
    />
    <img
      src={`${prefix}sprites/prop-bottle.png`}
      alt=""
      class="jm-pixel-sprite jm-reef-prop jm-reef-prop--bottle"
      style="left: 72%; top: 90%; height: 36px; width: auto;"
    />
  </div>

  <!-- Swimming & Drifting Sea Creatures (Layered Depth & Dynamic Paths) -->
  <div class="jm-reef__critters" aria-hidden="true">
    <!-- Distant Background School (Parallax Depth) -->
    <div class="jm-critter-track jm-critter-track--school-far" style="top: 32%; left: 10%;">
      <img
        src={`${prefix}sprites/critter-school.png`}
        alt=""
        class="jm-pixel-sprite jm-critter-img--school-far"
        style="height: 20px; width: auto;"
      />
    </div>

    <!-- Hero Gliding Sea Turtle -->
    <div class="jm-critter-track jm-critter-track--turtle" style="top: 14%; left: 6%;">
      <img
        src={`${prefix}sprites/critter-turtle.png`}
        alt=""
        class="jm-pixel-sprite jm-critter-img--turtle"
        style="height: 50px; width: auto;"
      />
    </div>

    <!-- Mid-Water Schooling Minnows -->
    <div class="jm-critter-track jm-critter-track--school-mid" style="top: 26%; left: 54%;">
      <img
        src={`${prefix}sprites/critter-school.png`}
        alt=""
        class="jm-pixel-sprite"
        style="height: 28px; width: auto;"
      />
    </div>

    <!-- Patrolling Blue Tang -->
    <div class="jm-critter-track jm-critter-track--tang" style="top: 41%; left: 48%;">
      <img
        src={`${prefix}sprites/critter-tang.png`}
        alt=""
        class="jm-pixel-sprite"
        style="height: 25px; width: auto;"
      />
    </div>

    <!-- Playful Clownfish near Corals -->
    <div class="jm-critter-track jm-critter-track--clownfish" style="top: 52%; left: 64%;">
      <img
        src={`${prefix}sprites/critter-clownfish.png`}
        alt=""
        class="jm-pixel-sprite"
        style="height: 27px; width: auto;"
      />
    </div>

    <!-- Pulsing Bioluminescent Jellyfish -->
    <div class="jm-critter-track jm-critter-track--jellyfish" style="top: 21%; left: 78%;">
      <img
        src={`${prefix}sprites/critter-jellyfish.png`}
        alt=""
        class="jm-pixel-sprite jm-critter-img--jellyfish"
        style="height: 48px; width: auto;"
      />
    </div>

    <!-- Scuttling Foreground Hermit Crab -->
    <div class="jm-critter-track jm-critter-track--crab" style="top: 90%; left: 56%;">
      <img
        src={`${prefix}sprites/critter-crab.png`}
        alt=""
        class="jm-pixel-sprite jm-critter-img--crab"
        style="height: 32px; width: auto;"
      />
    </div>
  </div>

  <!-- Rising Pixel Bubbles -->
  <div class="jm-bubble" style="bottom: 18%; left: 22%; animation-delay: 0s;" aria-hidden="true"></div>
  <div class="jm-bubble" style="bottom: 24%; left: 56%; animation-delay: 2.1s; width: 5px; height: 5px;" aria-hidden="true"></div>
  <div class="jm-bubble" style="bottom: 14%; left: 78%; animation-delay: 4.3s;" aria-hidden="true"></div>
  <div class="jm-bubble" style="bottom: 30%; left: 38%; animation-delay: 3.2s; width: 4px; height: 4px;" aria-hidden="true"></div>
  <div class="jm-bubble" style="bottom: 20%; left: 68%; animation-delay: 1.4s; width: 5px; height: 5px;" aria-hidden="true"></div>

  <!-- Bioluminescent Night Plankton -->
  <div class="night-only" aria-hidden="true">
    <div class="jm-plankton" style="top: 34%; left: 18%; animation-delay: 0s;"></div>
    <div class="jm-plankton" style="top: 50%; left: 46%; animation-delay: 1.4s;"></div>
    <div class="jm-plankton" style="top: 40%; left: 76%; animation-delay: 2.6s;"></div>
    <div class="jm-plankton" style="top: 64%; left: 30%; animation-delay: 0.9s;"></div>
    <div class="jm-plankton" style="top: 72%; left: 68%; animation-delay: 2s;"></div>
    <div class="jm-plankton" style="top: 26%; left: 60%; animation-delay: 3.1s;"></div>
  </div>

  <!-- Subtle Underwater Atmosphere & Edge Vignette -->
  <div class="jm-reef__atmosphere" aria-hidden="true"></div>

  <!-- Floating Controls -->
  <div class="jm-reef__hud">
    <button
      id="theme-toggle"
      type="button"
      class="jm-reef-pill"
      aria-label="Switch between sunlit day and bioluminescent night"
      aria-pressed="false"
    >
      Switch to night
    </button>
    <button
      id="labels-toggle"
      type="button"
      class="jm-reef-pill"
      aria-pressed="true"
    >
      Hide labels
    </button>
  </div>

  <!-- Interactive Project Corals (Depth-Scaled & Grounded) -->
  <div id="reef-corals" class="jm-reef__corals">
    {sortedProjects.map((project, idx) => {
      const stageMeta = getStageMeta(project.stage);
      const spriteSrc = getCoralSpritePath(project.stage, project.species, project.spriteVariant, baseUrl);
      const z = Math.round(project.posY / 2);
      const shouldSway = project.stage === 'reef' || project.stage === 'branch';
      const depthScale = getDepthScale(project.posY);
      const depthLayer = getDepthLayer(project.posY);
      return (
        <button
          type="button"
          class={`jm-coral-node jm-coral-node--${depthLayer}`}
          data-slug={project.slug}
          style={`left: ${project.posX}%; top: ${project.posY}%; z-index: ${z}; --depth-scale: ${depthScale};`}
          aria-label={`${project.title} (${stageMeta.label})`}
        >
          <span class="jm-coral-node__ring" aria-hidden="true"></span>
          <span
            class={`jm-coral-node__sprite-wrap${shouldSway ? ' jm-sway' : ''}`}
            style={`animation-delay: -${((idx * 0.8) % 4).toFixed(1)}s;`}
          >
            <img
              src={spriteSrc}
              alt=""
              class="jm-pixel-sprite"
              style={`height: ${stageMeta.displayHeight}px; width: auto;`}
              loading="eager"
            />
          </span>
          <span class="jm-coral-node__tag">{project.title}</span>
        </button>
      );
    })}
  </div>

  <!-- Bottom Status Caption -->
  <div class="jm-reef__caption">
    <div class="jm-reef-pill jm-reef-pill--static">
      <span id="reef-caption">Select any coral to read its user story</span>
    </div>
  </div>
</aside>
